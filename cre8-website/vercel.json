{
  "rewrites": [
    { "source": "/tiktok", "destination": "/tiktok.html" },
    { "source": "/tiktok/", "destination": "/tiktok.html" },
    { "source": "/tiktok-signs", "destination": "/tiktok-signs.html" },
    { "source": "/tiktok-signs/", "destination": "/tiktok-signs.html" }
  ],
  "headers": [
    {
      "source": "/(.*).xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    }
  ]
}
